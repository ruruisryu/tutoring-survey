# ─────────────────────────────────────────────────────────────
# 클라이언트 공개 설정 (브라우저 번들에 포함됨 · 공개되어도 되는 값만)
# 로컬에서는 이 파일을 .env.local 로 복사해 채웁니다. .env.local 은 커밋하지 않습니다.
# GitHub Pages 배포 시에는 저장소 Actions Variables 에 같은 이름으로 등록합니다.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_...)
# (예전 프로젝트라면 legacy anon key 를 VITE_SUPABASE_ANON_KEY 로 넣어도 동작합니다)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# GitHub Pages 프로젝트 사이트면 /저장소이름/ (워크플로가 자동으로 채움). 로컬 개발은 비워둠.
VITE_BASE_PATH=

# ─────────────────────────────────────────────────────────────
# 서버 비밀 설정 — 이 프로젝트의 프런트엔드에는 필요 없습니다.
# 아래 값은 절대 VITE_ 로 시작하는 이름이나 이 저장소에 넣지 마세요.
#   - Supabase secret key (sb_secret_...) / service_role key
#   - 데이터베이스 비밀번호
# 관리자 등록 같은 서버 권한 작업은 Supabase Dashboard 의 SQL Editor 에서 실행합니다.
# ─────────────────────────────────────────────────────────────
